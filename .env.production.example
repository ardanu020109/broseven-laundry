# Contoh .env untuk PRODUCTION. Salin menjadi .env di server, lalu isi nilai yang bertanda GANTI.
APP_NAME="BroSeven! Laundry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laundry.contoh.com            # GANTI: alamat HTTPS sebenarnya

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=broseven_laundry
DB_USERNAME=broseven_app                       # GANTI: jangan memakai root
DB_PASSWORD=                                   # GANTI: password kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=laundry.contoh.com    # GANTI: domain tanpa https://

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# Hanya untuk seeding pertama. HAPUS baris ADMIN_PASSWORD setelah login pertama dan ganti password.
ADMIN_NAME="Pemilik"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@laundry.contoh.com           # GANTI
ADMIN_PASSWORD=                                # GANTI sementara, hapus setelah dipakai

WHATSAPP_DRIVER=click_to_chat

# Keamanan dan operasional
CSP_MODE=report-only                           # ubah ke enforce setelah tidak ada peringatan CSP
TRUSTED_PROXIES=                               # isi * atau IP proxy jika di belakang Cloudflare/load balancer
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
ACTIVITY_LOG_RETENTION_DAYS=365
MYSQLDUMP_PATH=mysqldump

VITE_APP_NAME="${APP_NAME}"