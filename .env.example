APP_NAME="BroSeven! Laundry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (buat database terlebih dahulu)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=broseven_laundry
DB_USERNAME=root
DB_PASSWORD=

# Sesi dan login SPA (Sanctum). Domain harus sama dengan alamat yang dibuka di browser.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# Admin awal (dipakai seeder). WAJIB diisi sebelum php artisan db:seed.
ADMIN_NAME="Admin BroSeven"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@broseven.test
ADMIN_PASSWORD=

WHATSAPP_DRIVER=click_to_chat

# Operasional (opsional)
REPORT_EXPORT_LIMIT=10000
CSP_MODE=report-only
TRUSTED_PROXIES=
ACTIVITY_LOG_RETENTION_DAYS=365
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_PATH=mysqldump

VITE_APP_NAME="${APP_NAME}"